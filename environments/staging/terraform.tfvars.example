# 운영과 같은 GCP 프로젝트를 사용하되, 스테이징 리소스는 별도 이름과 VPC로 생성합니다.
project_id = "project-7b071b48-8637-467a-80d"

# TODO: staging.mulostudio.com 사용 여부를 확인하고, 필요하면 실제 스테이징 도메인으로 수정하세요.
# 적용 후 이 도메인의 A 레코드를 terraform output load_balancer_ip로 연결해야 합니다.
domain = "staging.mulostudio.com"

# TODO: GCS 버킷 이름은 전역에서 유일해야 합니다. 충돌하면 스테이징 전용 이름으로 수정하세요.
# 운영 버킷 muro-bucket-1과 공유하지 않습니다.
image_bucket_name = "mulo-v2-staging-images-7b071b48-8637-467a-80d"

name_prefix = "mulo-v2-staging"
subnet_cidr = "10.21.0.0/24"

# DB와 VM을 처음 생성할 때는 true가 필요합니다. 사용하지 않을 때 false로 변경합니다.
runtime_enabled = true
